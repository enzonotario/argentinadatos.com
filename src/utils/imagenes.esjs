importar fs desde 'node:fs'
importar path desde 'node:path'
importar { pipeline } desde 'node:stream/promises'

exportar funcion normalizarNombre(texto) {
  retornar texto.aMinusculas().normalizar('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]/g, '-')
    .replace(/-+/g, '-').reemplazar(/^-|-$/g, '');
}

exportar asincrono funcion descargarImagen(url, directorio, nombreArchivo) {
  si (!url) retornar nulo

  const rutaDirectorio = path.juntar('datos', 'static', directorio)
  si (!fs.existsSync(rutaDirectorio)) {
    fs.mkdirSync(rutaDirectorio, { recursive: verdadero })
  }

  const extension = (path.extname(url.dividir('?')[0]) || '.png').aMinusculas()
  const nombreFinal = `${nombreArchivo}${extension}`
  const rutaArchivo = path.juntar(rutaDirectorio, nombreFinal)

  si (fs.existsSync(rutaArchivo)) {
    retornar `https://api.argentinadatos.com/static/${directorio}/${nombreFinal}`
  }

  const headers = {
    'User-Agent':
      'ArgentinaDatosBot/1.0 (https://argentinadatos.com; hi@argentinadatos.com)',
  }

  intentar {
    const respuesta = esperar fetch(url, { headers })
    si (!respuesta.ok) lanzar crear Error(`Fallo al descargar ${url}`)

    esperar pipeline(respuesta.body, fs.createWriteStream(rutaArchivo))

    retornar `https://api.argentinadatos.com/static/${directorio}/${nombreFinal}`
  } capturar (error) {
    consola.error(`Error descargando imagen desde ${url}:`, error)
    retornar nulo
  }
}
