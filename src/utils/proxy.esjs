exportar funcion construirRequestConProxy(urlDestino, opciones = {}, env = import.meta.env) {
  const proxyUrl = env.VITE_PROXY_URL
  const proxyToken = env.VITE_PROXY_TOKEN
  const usaProxy = Boolean(proxyUrl && proxyToken)

  const headersNormalizados = normalizarHeaders(opciones.headers)

  si (!usaProxy) {
    retornar {
      usaProxy: falso,
      url: urlDestino,
      opciones: {
        ...opciones,
        headers: headersNormalizados,
      },
    }
  }

  retornar {
    usaProxy: verdadero,
    url: proxyUrl,
    opciones: {
      ...opciones,
      headers: {
        ...headersNormalizados,
        'x-proxy-token': proxyToken,
        'x-target-url': urlDestino,
      },
    },
  }
}

funcion normalizarHeaders(headers = {}) {
  si (headers instanciaDe Headers) {
    retornar Object.fromEntries(headers.entries())
  }

  si (Array.isArray(headers)) {
    retornar Object.fromEntries(headers)
  }

  retornar { ...headers }
}
