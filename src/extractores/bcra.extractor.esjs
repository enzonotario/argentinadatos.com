importar axios desde 'axios'
importar { logGrupo, logError } desde '@/log.esjs'

process.env['NODE_TLS_REJECT_UNAUTHORIZED'] = 0

const log = logGrupo({ fuente: 'bcra.extractor', tipo: 'extraccion' })

exportar asincrono funcion extraerBcra(serie, desde, hasta) {
  const intentos = 3

  para (var intento = 0; intento < intentos; intento++) {
    intentar {
      const respuesta = esperar obtenerRespuesta(serie, desde, hasta)

      retornar respuesta
    } capturar (error) {
      logError(log, error)
    }

    esperar crear Promesa(resuelve => {
      setTimeout(resuelve, 700)
    })
  }

  lanzar crear Error(
    `No se pudo extraer los datos del BCRA para la serie ${serie}`,
  )
}

asincrono funcion obtenerRespuesta(serie, desde, hasta) {
  const url =
    'http://www.bcra.gob.ar/PublicacionesEstadisticas/Principales_variables_datos.asp'

  const respuesta = esperar fetch(url, {
    method: 'POST',
    body: crear URLSearchParams({
      fecha_desde: desde,
      fecha_hasta: hasta,
      primeravez: '1',
      serie: serie,
    }),
  })

  retornar respuesta.text()
}

exportar asincrono funcion extraerBcraApi(serie, desde, hasta) {
  const intentos = 3

  para (var intento = 0; intento < intentos; intento++) {
    const url = `https://api.bcra.gob.ar/estadisticas/v4.0/Monetarias/${serie}?desde=${desde}&hasta=${hasta}`

    intentar {
      const respuesta = esperar axios.get(url)

      // console.log(respuesta.data.results[0].detalle)
      // return respuesta.data.results

      const respuestaSerie = respuesta.data.results.buscar(
        r => r.idVariable === serie,
      )

      si (!respuestaSerie) {
        lanzar crear Error(
          `No se encontró la serie ${serie} en la respuesta del BCRA API`,
        )
      }

      retornar respuestaSerie.detalle
    } capturar (error) {
      logError(log, error)
    }

    esperar crear Promesa(resuelve => {
      setTimeout(resuelve, 700)
    })
  }

  lanzar crear Error(
    `No se pudo extraer los datos del BCRA para la serie ${serie}`,
  )
}
