importar { cronFeriados } desde '@/feriados/feriados.cron.esjs'
importar { cronCotizaciones } desde '@/cotizaciones/cotizaciones.cron.esjs'
importar { cronFinanzas } desde '@/finanzas/finanzas.cron.esjs'
importar fci desde '@/finanzas/fci/fci.comando.esjs'
importar fciIA desde '@/finanzas/fci/fciIA.comando.esjs'
importar riesgoPais desde '@/finanzas/riesgoPais/riesgoPais.comando.esjs'
importar rendimientos desde '@/finanzas/rendimientos/rendimientos.comando.esjs'
importar criptopesos desde '@/finanzas/criptopesos/criptopesos.comando.esjs'
importar plazoFijoComando desde '@/finanzas/plazoFijo/plazoFijo.comando.esjs'
importar plazoFijoUvaPagoPeriodicoComando desde '@/finanzas/plazoFijo/plazoFijoUvaPagoPeriodico.comando.esjs'
importar letrasComando desde '@/finanzas/letras/letras.comando.esjs'
importar remComando desde '@/finanzas/rem/rem.comando.esjs'
importar presidentesComando desde '@/presidentes/presidentes.comando.esjs'
importar { actualizarOpenApiAño } desde '@/utils/actualizarOpenApiAño.esjs'

const predefinidos = {
  diario: ['/v1/cotizaciones', '/v1/finanzas'],
  mensual: ['/v1/feriados'],
  fci: ['/v1/finanzas/fci'],
  riesgoPais: ['/v1/finanzas/riesgo-pais'],
  fciIA: ['/v1/finanzas/fciIA'],
  rendimientos: ['/v1/finanzas/rendimientos'],
  criptopesos: ['/v1/finanzas/criptopesos'],
  rem: ['/v1/finanzas/rem'],
  actualizarOpenApiAño: ['actualizar-openapi-year'],
}

exportar asincrono funcion iniciar(comando) {
  const comandoDesdeArgumento = comando === indefinido

  comando = comando || process.argv[2]

  si (comandoDesdeArgumento) {
    consola.escribir('Comando: ' + comando)
  } sino {
    consola.escribir("\tComando: '" + comando + "'")
  }

  elegir (comando) {
    caso 'diario':
    caso 'mensual':
    caso 'fci':
    caso 'fciIA':
    caso 'riesgoPais':
    caso 'rendimientos':
    caso 'criptopesos':
    caso 'rem':
      para (const path de predefinidos[comando]) {
        consola.escribir('- ' + path)
        esperar iniciar(path)
      }
      romper
    caso '/v1/feriados':
      esperar cronFeriados()
      romper
    caso '/v1/cotizaciones':
      esperar cronCotizaciones()
      romper
    caso '/v1/finanzas':
      esperar cronFinanzas()
      romper
    caso '/v1/finanzas/fci':
      esperar fci()
      romper
    caso '/v1/finanzas/fciIA':
      esperar fciIA()
      romper
    caso '/v1/finanzas/riesgo-pais':
      esperar riesgoPais()
      romper
    caso '/v1/finanzas/rendimientos':
      esperar rendimientos()
      romper
    caso '/v1/finanzas/criptopesos':
      esperar criptopesos()
      romper
    caso '/v1/finanzas/plazo-fijo':
      esperar plazoFijoComando()
      romper
    caso '/v1/finanzas/tasas/plazo-fijo-uva-pago-periodico':
      esperar plazoFijoUvaPagoPeriodicoComando()
      romper
    caso '/v1/finanzas/letras':
      esperar letrasComando()
      romper
    caso '/v1/finanzas/rem':
      esperar remComando()
      romper
    caso '/v1/presidentes':
      esperar presidentesComando()
      romper
    caso 'actualizar-openapi-year':
      esperar actualizarOpenApiAño()
      romper
      porDefecto: consola.escribir('No se encontro el comando')
      romper
  }

  si (comandoDesdeArgumento) {
    consola.escribir('Finalizado con éxito')
  }
}
