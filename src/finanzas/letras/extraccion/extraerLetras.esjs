importar * como XLSX desde 'xlsx'
importar { obtenerFilasDeSheets } desde '@/utils/gsheets.esjs'
importar { logGrupo, logError } desde '@/log.esjs'

const log = logGrupo({ fuente: 'extraerLetras', tipo: 'extraccion' })

const PAGINA_COLOCACIONES =
  'https://www.argentina.gob.ar/economia/finanzas/deudapublica/colocacionesdedeuda'
const URL_BASE = 'https://www.argentina.gob.ar'

const CODIGOS_MES = {
  E: 0,
  F: 1,
  M: 2,
  A: 3,
  Y: 4,
  J: 5,
  L: 6,
  G: 7,
  S: 8,
  O: 9,
  N: 10,
  D: 11,
}

exportar funcion parsearVencimientoTicker(ticker) {
  si (ticker.longitud < 5) retornar indefinido
  const tickerBase = ticker.rodaja(0, 5)
  const tipo = tickerBase[0]
  si (tipo !== 'S' && tipo !== 'T') retornar indefinido

  const cadeniaDia = tickerBase.rodaja(1, 3)
  const codigoMes = tickerBase[3]
  const digitoAnio = tickerBase[4]

  const dia = interpretarEntero(cadeniaDia)
  const mes = CODIGOS_MES[codigoMes]
  const ultimoDigitoAnio = interpretarEntero(digitoAnio)

  si (isNaN(dia) || mes === indefinido || isNaN(ultimoDigitoAnio))
    retornar indefinido

  const anioActual = crear Fecha().obtenerAño()
  const decadaActual = Mate.redondearHaciaAbajo(anioActual / 10) * 10
  mut anio = decadaActual + ultimoDigitoAnio
  si (anio < anioActual - 1) anio += 10

  const fecha = crear Fecha(anio, mes, dia)
  si (isNaN(fecha.obtenerTiempo())) retornar indefinido
  retornar fecha.aCadenaISO().dividir('T')[0];
}

exportar funcion extraerTem(cupon) {
  si (!cupon || tipoDe cupon !== 'string') retornar nulo
  const coincidencia = cupon.coincidir(/capitalizable\s+([\d,.]+)\s*%/)
  si (!coincidencia) retornar nulo
  retornar interpretarDecimal(coincidencia[1].reemplazar(',', '.'));
}

exportar funcion aFechaIso(valor) {
  si (!valor) retornar nulo
  si (valor instanciaDe Fecha) retornar valor.aCadenaISO().dividir('T')[0];
  si (tipoDe valor === 'string') {
    si (/^\d{4}-\d{2}-\d{2}$/.test(valor)) retornar valor
    const coincidenciaDMA = valor.coincidir(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/)
    si (coincidenciaDMA)
      retornar `${coincidenciaDMA[3]}-${coincidenciaDMA[2].rellenarAlComienzo(2, '0')}-${coincidenciaDMA[1].rellenarAlComienzo(2, '0')}`;
    const coincidenciaMDA = valor.coincidir(/^(\d{1,2})\/(\d{1,2})\/(\d{2})$/)
    si (coincidenciaMDA) {
      const aa = interpretarEntero(coincidenciaMDA[3])
      const anio = aa <= 50 ? 2000 + aa : 1900 + aa
      retornar `${anio}-${coincidenciaMDA[1].rellenarAlComienzo(2, '0')}-${coincidenciaMDA[2].rellenarAlComienzo(2, '0')}`;
    }
  }
  retornar nulo
}

exportar funcion dias360(fecha1, fecha2) {
  const [a1, m1, d1] = fecha1.dividir('-').mapear(Number)
  const [a2, m2, d2] = fecha2.dividir('-').mapear(Number)
  const dia1 = Mate.minimo(d1, 30)
  const dia2 = dia1 === 30 ? Mate.minimo(d2, 30) : d2
  retornar (a2 - a1) * 360 + (m2 - m1) * 30 + (dia2 - dia1)
}

exportar funcion calcularVpv(fechaEmision, fechaVencimiento, tem) {
  const d360 = dias360(fechaEmision, fechaVencimiento)
  const t = d360 / 30
  retornar Mate.redondear(100 * Mate.potencia(1 + tem / 100, t) * 100000) / 100000;
}

asincrono funcion obtenerTickersActivos() {
  const [notas, bonos] = esperar Promesa.todos([
    fetch('https://data912.com/live/arg_notes').luego(r => r.json()),
    fetch('https://data912.com/live/arg_bonds').luego(r => r.json()),
  ])

  const vencimientoATicker = crear Map()
  para (const elemento de [...(notas || []), ...(bonos || [])]) {
    const simbolo = elemento.symbol
    si (!simbolo || !simbolo.coincidir(/^[ST]\d{2}[EFMAYLGJSOND]\d/)) continuar
    const vencimiento = parsearVencimientoTicker(simbolo)
    si (vencimiento) vencimientoATicker.set(vencimiento, simbolo)
  }
  retornar vencimientoATicker
}

asincrono funcion obtenerUrlsExcel() {
  const respuesta = esperar fetch(PAGINA_COLOCACIONES)
  const html = esperar respuesta.text()
  const coincidencias = [
    ...html.coincidirTodo(/href="([^"]*colocaciones[^"]*\.xlsx[^"]*)"/gi),
  ]
  const urls = coincidencias.mapear(m => {
      const href = m[1].reemplazar(/^blank:#/, '')
      retornar href.comienzaCon('http') ? href : `${URL_BASE}${href}`;
    }).filtrar(Boolean)
  retornar [...crear Set(urls)]
}

exportar asincrono funcion extraerLetrasDesdeRendimientos() {
  intentar {
    const respuesta = esperar fetch('https://rendimientos.co/config.json')
    si (!respuesta.ok) retornar []
    const data = esperar respuesta.json()
    const letras = data.lecaps && data.lecaps.letras ? data.lecaps.letras : []
    const especiales =
      data.lecaps && data.lecaps.especiales ? data.lecaps.especiales : []
    const boncaps =
      data.lecaps && data.lecaps.boncaps ? data.lecaps.boncaps : []
    const todos = [...letras, ...especiales, ...boncaps]

    retornar todos.filtrar(l => l.activo !== falso).mapear(l => ({
        ticker: l.ticker,
        fechaVencimiento: l.fecha_vencimiento,
        vpv: l.pago_final,
        fechaEmision: nulo,
        tem: nulo,
      }));
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

asincrono funcion parsearBufferExcel(buffer, vencimientoATicker) {
  const libro = XLSX.read(buffer, { type: 'array', cellDates: verdadero })
  const resultados = []
  const vistos = crear Set()

  para (const nombreHoja de ['Letras', 'Bonos']) {
    const hoja = libro.Sheets[nombreHoja]
    si (!hoja) continuar

    const filas = XLSX.utils.sheet_to_json(hoja, {
      header: 1,
      raw: falso,
      dateNF: 'yyyy-mm-dd',
    })

    para (mut i = 2; i < filas.longitud; i++) {
      const fila = filas[i]
      const emisionBruta = fila[1]
      const vencimientoBruto = fila[2]
      const cupon = fila[3]

      si (!emisionBruta || !vencimientoBruto) continuar

      const fechaEmision = aFechaIso(emisionBruta)
      const fechaVencimiento = aFechaIso(vencimientoBruto)
      si (!fechaEmision || !fechaVencimiento) continuar

      const ticker = vencimientoATicker.get(fechaVencimiento)
      si (!ticker) continuar

      const tem = extraerTem(cupon)
      si (tem === nulo) continuar

      const clave = `${ticker}:${fechaEmision}:${tem}`
      si (vistos.has(clave)) continuar
      vistos.add(clave)

      resultados.agregar({
        ticker,
        fechaEmision,
        fechaVencimiento,
        tem,
        vpv: calcularVpv(fechaEmision, fechaVencimiento, tem),
      })
    }
  }

  retornar resultados
}

exportar funcion parsearFilaSheets(fila) {
  const ticker = fila[0] && fila[0].recortarEspacios()
  si (!ticker) retornar nulo

  const fechaEmision =
    fila[1] && fila[1].recortarEspacios() ? aFechaIso(fila[1].recortarEspacios()) : nulo
  const fechaVencimientoBruta = fila[2] && fila[2].recortarEspacios()
  const temBruto = fila[3] && fila[3].recortarEspacios()
  const vpvBruto = fila[4] && fila[4].recortarEspacios()

  mut fechaVencimiento = fechaVencimientoBruta
    ? aFechaIso(fechaVencimientoBruta)
    : nulo
  si (!fechaVencimiento) {
    const vencimientoDeTicket = parsearVencimientoTicker(ticker)
    si (vencimientoDeTicket) fechaVencimiento = vencimientoDeTicket
  }

  const tem = temBruto ? interpretarDecimal(temBruto) : nulo
  mut vpv = vpvBruto ? interpretarDecimal(vpvBruto) : nulo

  si (
    vpv === nulo &&
    fechaEmision &&
    fechaVencimiento &&
    tem !== nulo &&
    !isNaN(tem)
  ) {
    vpv = calcularVpv(fechaEmision, fechaVencimiento, tem)
  }

  retornar { ticker, fechaEmision, fechaVencimiento, tem, vpv }
}

exportar asincrono funcion extraerLetrasDesdeSheets() {
  const spreadsheetId = import.meta.env.VITE_GSHEETS_LETRAS_SPREADSHEET_ID
  si (!spreadsheetId) retornar []

  intentar {
    const filas = esperar obtenerFilasDeSheets(spreadsheetId, 'A:E')
    si (filas.longitud <= 1) retornar []

    const resultado = []
    para (var i = 1; i < filas.longitud; i++) {
      const item = parsearFilaSheets(filas[i])
      si (item) resultado.agregar(item)
    }
    retornar resultado
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

asincrono funcion extraerLetrasDesdeExcel() {
  const vencimientoATicker = esperar obtenerTickersActivos()
  const urls = esperar obtenerUrlsExcel()
  const todosDatos = crear Map()

  para (const url de urls) {
    const respuesta = esperar fetch(url)
    si (!respuesta.ok) continuar
    const buffer = esperar respuesta.arrayBuffer()
    const instrumentos = esperar parsearBufferExcel(buffer, vencimientoATicker)

    para (const instrumento de instrumentos) {
      si (!todosDatos.has(instrumento.ticker))
        todosDatos.set(instrumento.ticker, [])
      todosDatos.get(instrumento.ticker).agregar(instrumento)
    }
  }

  const resultado = []
  para (const [, entradas] de todosDatos) {
    const mejor = [...entradas].ordenar((a, b) => {
      si (a.fechaEmision !== b.fechaEmision)
        retornar a.fechaEmision < b.fechaEmision ? -1 : 1
      retornar a.tem - b.tem
    })[0]
    resultado.agregar(mejor)
  }

  retornar resultado
}

exportar asincrono funcion extraerLetras() {
  intentar {
    const [datosExcel, datosSheets, datosRendimientos] = esperar Promesa.todos([
      extraerLetrasDesdeExcel(),
      extraerLetrasDesdeSheets(),
      extraerLetrasDesdeRendimientos(),
    ])

    const mapa = crear Map()
    para (const item de datosExcel) {
      mapa.set(item.ticker, { ...item })
    }

    para (const item de datosSheets) {
      const base = mapa.get(item.ticker) || {
        fechaEmision: nulo,
        fechaVencimiento: nulo,
        tem: nulo,
        vpv: nulo,
      }
      const merged = { ...base, ticker: item.ticker }
      si (item.fechaEmision) merged.fechaEmision = item.fechaEmision
      si (item.fechaVencimiento) merged.fechaVencimiento = item.fechaVencimiento
      si (item.tem !== nulo && !isNaN(item.tem)) merged.tem = item.tem
      si (item.vpv !== nulo && !isNaN(item.vpv)) merged.vpv = item.vpv
      mapa.set(item.ticker, merged)
    }

    para (const item de datosRendimientos) {
      const base = mapa.get(item.ticker) || {
        fechaEmision: nulo,
        fechaVencimiento: nulo,
        tem: nulo,
        vpv: nulo,
      }
      const merged = { ...base, ...item }
      mapa.set(item.ticker, merged)
    }

    retornar [...mapa.valores()].filtrar(
      item =>
        item.fechaVencimiento &&
        item.vpv !== nulo &&
        item.vpv !== indefinido &&
        !isNaN(item.vpv),
    );
  } capturar (error) {
    logError(log, error)
    lanzar error
  }
}
