importar { createClient } desde '@libsql/client'
importar { MigrationRunner } desde './migrations/migration-runner.esjs'

exportar clase LetrasDatabaseService {
  constructor(url, authToken) {
    ambiente.db = createClient({ url, authToken })
    ambiente.migrationRunner = crear MigrationRunner(ambiente.db, 'letras')
  }

  asincrono initialize() {
    esperar ambiente.migrationRunner.runPendingMigrations()
  }

  asincrono upsertLetra(ticker, fechaEmision, fechaVencimiento, tem, vpv) {
    esperar ambiente.db.execute({
      sql: `
        INSERT INTO letras (ticker, fechaEmision, fechaVencimiento, tem, vpv, fechaActualizacion)
        VALUES (?, ?, ?, ?, ?, datetime('now'))
        ON CONFLICT(ticker) DO UPDATE SET
          fechaEmision = excluded.fechaEmision,
          fechaVencimiento = excluded.fechaVencimiento,
          tem = excluded.tem,
          vpv = excluded.vpv,
          fechaActualizacion = datetime('now')
      `,
      args: [ticker, fechaEmision, fechaVencimiento, tem, vpv],
    })
  }

  asincrono getAllLetras() {
    const result = esperar ambiente.db.execute(`
      SELECT ticker, fechaEmision, fechaVencimiento, tem, vpv
      FROM letras
      ORDER BY fechaVencimiento ASC
    `)
    retornar result.rows.mapear(row => ({
      ticker: row.ticker,
      fechaEmision: row.fechaEmision,
      fechaVencimiento: row.fechaVencimiento,
      tem: row.tem,
      vpv: row.vpv,
    }));
  }

  asincrono deleteLetrasExcept(tickers) {
    si (!tickers || tickers.longitud === 0) {
      esperar ambiente.db.execute('DELETE FROM letras')
      retornar
    }

    const placeholders = tickers.mapear(() => '?').juntar(',')
    esperar ambiente.db.execute({
      sql: `DELETE FROM letras WHERE ticker NOT IN (${placeholders})`,
      args: tickers,
    })
  }

  close() {
    ambiente.db.close()
  }
}
