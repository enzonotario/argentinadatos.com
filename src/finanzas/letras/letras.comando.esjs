importar { extraerLetras } desde '@/finanzas/letras/extraccion/extraerLetras.esjs'
importar { guardarLetras } desde '@/finanzas/letras/guardado/guardarLetras.esjs'

exportar asincrono funcion ejecutarLetras() {
  intentar {
    const datos = esperar extraerLetras()
    esperar guardarLetras(datos)
  } capturar (error) {
    consola.error('Error al extraer datos de LECAPs/BONCAPs', error)
  }
}

exportar porDefecto ejecutarLetras
