importar { extraerGalicia } desde './extraerGalicia.esjs'
importar { extraerSupervielle } desde './extraerSupervielle.esjs'
importar { extraerBna } desde './extraerBna.esjs'
importar { logGrupo, logError } desde '@/log.esjs'

const log = logGrupo({
  fuente: 'extraerCuentasRemuneradasUsd',
  tipo: 'extraccion',
})

exportar asincrono funcion extraerCuentasRemuneradasUsd() {
  intentar {
    const resultados = esperar Promesa.todos([
      extraerGalicia(),
      extraerSupervielle(),
      extraerBna(),
    ])

    retornar resultados.plano();
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}
