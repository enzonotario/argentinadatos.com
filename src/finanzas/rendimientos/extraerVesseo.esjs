importar { format } desde 'date-fns'
importar axios desde 'axios'
importar { logGrupo, logError } desde '@/log.esjs'

const log = logGrupo({ fuente: 'extraerVesseo', tipo: 'rendimientos' })

exportar asincrono funcion extraerVesseo() {
  intentar {
    const respuesta = esperar axios.get(
      import.meta.env.VITE_FINANZAS_RENDIMIENTOS_VESSEO_URL,
    )

    si (!respuesta.data || respuesta.data.apy === indefinido) {
      retornar []
    }

    const fecha = format(crear Fecha(), 'yyyy-MM-dd')
    const apy = Numero(respuesta.data.apy) * 100

    retornar [
      {
        moneda: 'USDC',
        apy,
        fecha,
      },
    ]
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}
