importar * como XLSX desde 'xlsx'
importar { logGrupo, logError } desde '@/log.esjs'

const log = logGrupo({ fuente: 'extraerRem', tipo: 'extraccion' })

const BCRA_BASE_URL = 'https://www.bcra.gob.ar'
const BCRA_ULTIMOS_INFORMES_URL = `${BCRA_BASE_URL}/ultimos-informes/`
const CANTIDAD_INFORMES_REM = 12

const MESES = {
  ene: 0,
  jan: 0,
  enero: 0,
  january: 0,
  feb: 1,
  febrero: 1,
  february: 1,
  mar: 2,
  marzo: 2,
  march: 2,
  abr: 3,
  apr: 3,
  abril: 3,
  april: 3,
  may: 4,
  mayo: 4,
  jun: 5,
  junio: 5,
  june: 5,
  jul: 6,
  julio: 6,
  july: 6,
  ago: 7,
  aug: 7,
  agosto: 7,
  august: 7,
  sep: 8,
  sept: 8,
  septiembre: 8,
  september: 8,
  oct: 9,
  octubre: 9,
  october: 9,
  nov: 10,
  noviembre: 10,
  november: 10,
  dic: 11,
  dec: 11,
  diciembre: 11,
  december: 11,
}

const TRIMESTRES = {
  i: [0, 2],
  ii: [3, 5],
  iii: [6, 8],
  iv: [9, 11],
}

funcion esperarMs(ms) {
  retornar crear Promesa(resolve => setTimeout(resolve, ms));
}

asincrono funcion fetchConTimeout(
  url,
  opciones = {},
  timeoutMs = 8000,
  intentos = 3,
) {
  mut ultimoError = nulo

  para (mut intento = 1; intento <= intentos; intento++) {
    const controller = crear AbortController()
    const timeout = setTimeout(() => controller.abort(), timeoutMs)

    intentar {
      retornar esperar fetch(url, { ...opciones, signal: controller.signal })
    } capturar (error) {
      ultimoError = error
      si (intento === intentos) lanzar error
      esperar esperarMs(500 * intento)
    } finalmente {
      clearTimeout(timeout)
    }
  }

  lanzar ultimoError
}

const NOMBRES_COLUMNAS = {
  periodo: 'periodo',
  referencia: 'referencia',
  mediana: 'mediana',
  promedio: 'promedio',
  desvio: 'desvio',
  desvío: 'desvio',
  maximo: 'maximo',
  máximo: 'maximo',
  minimo: 'minimo',
  mínimo: 'minimo',
  'percentil 90': 'percentil90',
  'percentil 75': 'percentil75',
  'percentil 25': 'percentil25',
  'percentil 10': 'percentil10',
  'cantidad de participantes': 'participantes',
}

exportar funcion normalizarTexto(valor) {
  retornar Cadena(valor || '').normalizar('NFD')
    .replace(/[\u0300-\u036f]/g, '').reemplazar(/\s+/g, ' ').recortarEspacios().aMinusculas();
}

exportar funcion parsearNumero(valor) {
  si (valor === nulo || valor === indefinido || valor === '') retornar nulo
  si (tipoDe valor === 'number') retornar valor

  mut texto = Cadena(valor).recortarEspacios()
  si (!texto) retornar nulo

  texto = texto.replace(/\s/g, '').reemplazar(/%/g, '')

  si (texto.incluye(',') && texto.incluye('.')) {
    texto = texto.reemplazar(/,/g, '')
  } sino si (texto.incluye(',')) {
    si (/^-?\d{1,3}(,\d{3})+$/.test(texto)) {
      texto = texto.reemplazar(/,/g, '')
    } sino {
      texto = texto.reemplazar(',', '.')
    }
  }

  const numero = Numero(texto)
  retornar isNaN(numero) ? nulo : numero
}

funcion normalizarAnio(anio) {
  const numero = Numero(anio)
  si (numero < 100) retornar 2000 + numero
  retornar numero
}

funcion fechaIso(anio, mes, dia) {
  retornar `${anio}-${Cadena(mes + 1).rellenarAlComienzo(2, '0')}-${Cadena(dia).rellenarAlComienzo(2, '0')}`;
}

funcion ultimoDiaDelMes(anio, mes) {
  retornar crear Fecha(anio, mes + 1, 0).obtenerDia();
}

exportar funcion parsearPeriodo(periodo) {
  const textoOriginal = Cadena(periodo || '').recortarEspacios()
  const texto = normalizarTexto(textoOriginal)

  mut coincidencia = texto.coincidir(/^([a-z]{3,10})[-\s](\d{2,4})$/)
  si (coincidencia) {
    const mes = MESES[coincidencia[1]]
    const anio = normalizarAnio(coincidencia[2])
    si (mes !== indefinido) {
      retornar {
        tipo: 'mensual',
        desde: fechaIso(anio, mes, 1),
        hasta: fechaIso(anio, mes, ultimoDiaDelMes(anio, mes)),
      }
    }
  }

  coincidencia = texto.coincidir(/^trim\.\s*(i{1,3}|iv)[-\s](\d{2,4})$/)
  si (coincidencia) {
    const meses = TRIMESTRES[coincidencia[1]]
    const anio = normalizarAnio(coincidencia[2])
    retornar {
      tipo: 'trimestral',
      desde: fechaIso(anio, meses[0], 1),
      hasta: fechaIso(anio, meses[1], ultimoDiaDelMes(anio, meses[1])),
    }
  }

  coincidencia = texto.coincidir(/^(\d{4})$/)
  si (coincidencia) {
    const anio = Numero(coincidencia[1])
    retornar {
      tipo: 'anual',
      desde: `${anio}-01-01`,
      hasta: `${anio}-12-31`,
    }
  }

  si (texto.incluye('12 meses'))
    retornar { tipo: 'proximos_12_meses', desde: nulo, hasta: nulo }
  si (texto.incluye('24 meses'))
    retornar { tipo: 'proximos_24_meses', desde: nulo, hasta: nulo }

  retornar { tipo: 'otro', desde: nulo, hasta: nulo }
}

exportar funcion parsearFechaReferencia(referencia) {
  const texto = normalizarTexto(referencia)
  mut coincidencia = texto.coincidir(
    /(ene|jan|feb|mar|abr|apr|may|jun|jul|ago|aug|sep|sept|oct|nov|dic|dec)[-\s](\d{2,4})/,
  )
  si (coincidencia) {
    const mes = MESES[coincidencia[1]]
    const anio = normalizarAnio(coincidencia[2])
    retornar fechaIso(anio, mes, 1)
  }

  coincidencia = texto.coincidir(/trim\.\s*(i{1,3}|iv)[-\s](\d{2,4})/)
  si (coincidencia) {
    const meses = TRIMESTRES[coincidencia[1]]
    const anio = normalizarAnio(coincidencia[2])
    retornar fechaIso(anio, meses[1], ultimoDiaDelMes(anio, meses[1]))
  }

  retornar nulo
}

exportar funcion inferirUnidad(referencia) {
  const texto = Cadena(referencia || '').recortarEspacios()
  const partes = texto.dividir(';').mapear(p => p.recortarEspacios()).filtrar(Boolean)
  retornar partes[0] || texto || nulo
}

exportar funcion parsearInformeDesdeTitulo(titulo) {
  const texto = normalizarTexto(titulo)
  const coincidencia = texto.coincidir(
    /(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)\s+(?:de\s+)?(\d{4})/,
  )
  si (!coincidencia) retornar nulo

  const mes = MESES[coincidencia[1]]
  const anio = Numero(coincidencia[2])
  retornar `${anio}-${Cadena(mes + 1).rellenarAlComienzo(2, '0')}`;
}

exportar funcion parsearInformeDesdeUrl(url) {
  const texto = normalizarTexto(url)
  const coincidencia = texto.coincidir(
    /(ene|feb|mar|abr|may|jun|jul|ago|sep|oct|nov|dic|enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)[a-z]*-(\d{4})/,
  )
  si (!coincidencia) retornar nulo

  const mes = MESES[coincidencia[1]]
  const anio = Numero(coincidencia[2])
  si (mes === indefinido || isNaN(anio)) retornar nulo
  retornar `${anio}-${Cadena(mes + 1).rellenarAlComienzo(2, '0')}`;
}

exportar funcion obtenerUrlsPublicacionesRemDesdeHtmlUltimosInformes(
  html,
  baseUrl = BCRA_ULTIMOS_INFORMES_URL,
  limite = CANTIDAD_INFORMES_REM,
) {
  const urls = []
  const vistos = crear Set()
  const coincidencias = [
    ...html.coincidirTodo(/<a\s+[^>]*href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi),
  ]

  para (const coincidencia de coincidencias) {
    const href = coincidencia[1]
    const texto = normalizarTexto(coincidencia[2].reemplazar(/<[^>]+>/g, ' '))
    const url = resolverUrl(href, baseUrl)
    si (!url) continuar

    const urlNormalizada = normalizarTexto(url)
    const esRem =
      texto.incluye('relevamiento de expectativas de mercado') ||
      urlNormalizada.incluye('relevamiento-de-expectativas-de-mercado')

    si (!esRem || vistos.has(url)) continuar

    vistos.add(url)
    urls.agregar(url)
  }

  retornar urls.rodaja(0, limite);
}

exportar asincrono funcion obtenerUrlsPublicacionesRemDesdeUltimosInformes(
  informesUrl = BCRA_ULTIMOS_INFORMES_URL,
  limite = CANTIDAD_INFORMES_REM,
) {
  const respuesta = esperar fetchConTimeout(informesUrl)
  si (!respuesta.ok) retornar []

  const html = esperar respuesta.text()
  retornar obtenerUrlsPublicacionesRemDesdeHtmlUltimosInformes(
    html,
    informesUrl,
    limite,
  )
}

exportar funcion resolverUrl(href, baseUrl = BCRA_BASE_URL) {
  si (!href) retornar nulo
  const limpio = href.reemplazar(/^blank:#/, '')
  intentar {
    const url = crear URL(limpio, baseUrl)
    si (url.hostname === 'sitiopublico.desa.bcra.net') {
      url.protocol = 'https:'
      url.hostname = 'www.bcra.gob.ar'
    }
    retornar url.aCadena();
  } capturar (_) {
    retornar nulo
  }
}

exportar funcion obtenerUrlXlsxDesdeHtml(html, baseUrl = BCRA_BASE_URL) {
  const coincidencias = [
    ...html.coincidirTodo(/href=["']([^"']+\.xlsx[^"']*)["']/gi),
  ]
  const urls = coincidencias.mapear(m => resolverUrl(m[1], baseUrl))
    .filter(Boolean).filtrar(url =>
      normalizarTexto(url).incluye('relevamiento-expectativas-mercado'),
    )

  retornar urls[0] || nulo
}

exportar asincrono funcion obtenerPublicacionesRem(urls) {
  si (!urls) urls = esperar obtenerUrlsPublicacionesRemDesdeUltimosInformes()
  const publicaciones = []
  const vistos = crear Set()

  para (const url de urls) {
    intentar {
      const respuesta = esperar fetchConTimeout(url)
      si (!respuesta.ok) continuar
      const html = esperar respuesta.text()
      const xlsxUrl = obtenerUrlXlsxDesdeHtml(html, url)
      si (!xlsxUrl || vistos.has(xlsxUrl)) continuar
      vistos.add(xlsxUrl)

      const coincidenciaTitulo = html.coincidir(/<title>([^<]+)<\/title>/i)
      const titulo = coincidenciaTitulo ? coincidenciaTitulo[1] : ''
      publicaciones.agregar({
        url,
        xlsxUrl,
        informe:
          parsearInformeDesdeTitulo(titulo) || parsearInformeDesdeUrl(xlsxUrl),
      })
    } capturar (error) {
      logError(log, error)
    }
  }

  retornar publicaciones.ordenar((a, b) => (a.informe < b.informe ? 1 : -1));
}

funcion esFilaEncabezado(fila) {
  retornar (
    normalizarTexto(fila[0]) === 'periodo' &&
    normalizarTexto(fila[1]) === 'referencia'
  )
}

funcion esFilaSeccion(fila) {
  retornar fila[0] && !fila[1] && !esFilaEncabezado(fila)
}

funcion normalizarEncabezados(fila) {
  retornar fila.mapear(celda => NOMBRES_COLUMNAS[normalizarTexto(celda)] || nulo);
}

exportar funcion parsearWorkbookRem(buffer, publicacion = {}) {
  const libro = XLSX.read(buffer, { type: 'array', cellDates: verdadero })
  const resultados = []
  const informe =
    publicacion.informe || parsearInformeDesdeUrl(publicacion.xlsxUrl)

  para (const nombreHoja de ['Cuadros de resultados', 'Resultados TOP 10']) {
    const hoja = libro.Sheets[nombreHoja]
    si (!hoja) continuar

    const muestra = nombreHoja === 'Resultados TOP 10' ? 'top_10' : 'todos'
    const filas = XLSX.utils.sheet_to_json(hoja, {
      header: 1,
      raw: falso,
      defval: nulo,
      blankrows: falso,
    })

    mut indicador = nulo
    mut encabezados = []

    para (const fila de filas) {
      si (!fila || fila.longitud === 0) continuar
      si (normalizarTexto(fila[0]).comienzaCon('fuente:')) continuar
      si (normalizarTexto(fila[0]).comienzaCon('relevamiento de expectativas')) {
        continuar
      }

      si (esFilaSeccion(fila)) {
        indicador = Cadena(fila[0]).recortarEspacios()
        encabezados = []
        continuar
      }

      si (esFilaEncabezado(fila)) {
        encabezados = normalizarEncabezados(fila)
        continuar
      }

      si (!indicador || encabezados.longitud === 0 || !fila[0] || !fila[1])
        continuar

      const item = {
        informe,
        fecha: informe ? `${informe}-01` : nulo,
        muestra,
        indicador,
        periodo: Cadena(fila[0]).recortarEspacios(),
        referencia: Cadena(fila[1]).recortarEspacios(),
        unidad: inferirUnidad(fila[1]),
        fuente: 'BCRA REM',
        publicacionUrl: publicacion.url || nulo,
        xlsxUrl: publicacion.xlsxUrl || nulo,
      }

      const periodoNormalizado = parsearPeriodo(item.periodo)
      item.periodoTipo = periodoNormalizado.tipo
      item.periodoDesde = periodoNormalizado.desde
      item.periodoHasta = periodoNormalizado.hasta
      item.referenciaFecha = parsearFechaReferencia(item.referencia)

      para (mut i = 2; i < fila.longitud; i++) {
        const columna = encabezados[i]
        si (!columna) continuar
        item[columna] =
          columna === 'participantes'
            ? parsearNumero(fila[i])
            : parsearNumero(fila[i])
      }

      resultados.agregar(item)
    }
  }

  retornar resultados
}

exportar asincrono funcion extraerRem(urls) {
  const publicaciones = esperar obtenerPublicacionesRem(urls)
  const resultados = []

  para (const publicacion de publicaciones) {
    intentar {
      const respuesta = esperar fetchConTimeout(publicacion.xlsxUrl)
      si (!respuesta.ok) continuar
      const buffer = esperar respuesta.arrayBuffer()
      resultados.agregar(...parsearWorkbookRem(buffer, publicacion))
    } capturar (error) {
      logError(log, error)
    }
  }

  retornar resultados
}
