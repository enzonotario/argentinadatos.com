importar { RemDatabaseService } desde '../database/service.esjs'
importar { escribirRuta } desde '@/utils/rutas.esjs'

const TURSO_DATABASE_URL =
  import.meta.env.VITE_TURSO_DATABASE_URL || 'file:database.sqlite'
const TURSO_AUTH_TOKEN = import.meta.env.VITE_TURSO_AUTH_TOKEN

exportar asincrono funcion guardarRem(
  items,
  url = TURSO_DATABASE_URL,
  authToken = TURSO_AUTH_TOKEN,
) {
  const db = crear RemDatabaseService(url, authToken)

  intentar {
    esperar db.initialize()

    esperar db.deleteAllExpectativas()

    para (const item de items) {
      esperar db.upsertExpectativa(item)
    }

    retornar esperar generarEndpointsEstaticos(db)
  } finalmente {
    db.close()
  }
}

asincrono funcion generarEndpointsEstaticos(db) {
  const todos = esperar db.getAllExpectativas()
  const ultimo = esperar db.getLatestExpectativas()
  const informes = agruparPorInforme(todos)
  const endpoints = ['/rems/ultimo']

  escribirRuta('/rems/ultimo', ultimo)

  para (const informe de informes.claves()) {
    const [anio, mes] = informe.dividir('-')
    const endpoint = `/rems/${anio}/${mes}`
    endpoints.agregar(endpoint)
    escribirRuta(endpoint, informes.get(informe))
  }

  escribirRuta('/rems', endpoints)

  retornar endpoints
}

funcion agruparPorInforme(items) {
  const grupos = crear Map()

  para (const item de items) {
    si (!grupos.has(item.informe)) grupos.set(item.informe, [])
    grupos.get(item.informe).agregar(item)
  }

  retornar grupos
}
