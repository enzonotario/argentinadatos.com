importar { extraerRemesas } desde '@/finanzas/remesas/extraccion/extraerRemesas.esjs'
importar { guardarRemesas } desde '@/finanzas/remesas/guardado/guardarRemesas.esjs'

exportar asincrono funcion ejecutarRemesas() {
  intentar {
    const datos = esperar extraerRemesas()
    esperar guardarRemesas(datos)
  } capturar (error) {
    consola.error('Error al extraer remesas', error)
  }
}

exportar porDefecto ejecutarRemesas
