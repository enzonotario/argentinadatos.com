exportar const migration_003_add_nombre_column = {
  version: 3,
  name: 'add_nombre_column',

  asincrono up(db) {
    consola.escribir(
      'Iniciando migración 003: agregando columna nombre y renombrando semántica de fondo...',
    )

    intentar {
      esperar db.execute(`
        ALTER TABLE fci_variables ADD COLUMN nombre TEXT
      `)
    } capturar (error) {
      si (String(error).includes('duplicate column name: nombre')) {
        consola.escribir('La columna nombre ya existe en fci_variables, se omite el ALTER')
      } sino {
        lanzar error
      }
    }

    esperar db.execute(`
      UPDATE fci_variables SET nombre = fondo WHERE nombre IS NULL AND fondo IS NOT NULL
    `)

    esperar db.execute(`
      UPDATE fci_variables
      SET fondo = 'Compass Liquidez - Clase A'
      WHERE nombre = 'GLOBAL66'
    `)

    esperar db.execute(`
      CREATE INDEX IF NOT EXISTS idx_fci_variables_nombre ON fci_variables(nombre)
    `)

    consola.escribir('Migración 003 completada')
  },

  asincrono down() {
    consola.escribir('Migración 003: rollback no implementado para SQLite')
  },
}
