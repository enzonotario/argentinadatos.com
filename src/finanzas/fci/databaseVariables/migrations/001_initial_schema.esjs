exportar const migration_001_initial_schema = {
  version: 1,
  name: 'initial_schema',

  asincrono up(db) {
    consola.escribir(
      'Iniciando migración 001: creando esquema inicial de fci variables...',
    )

    esperar db.execute(`
      CREATE TABLE IF NOT EXISTS fci_variables (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        fondo TEXT NOT NULL,
        tna REAL NOT NULL,
        tea REAL NOT NULL,
        tope REAL,
        fecha TEXT NOT NULL,
        condiciones TEXT,
        condicionesCorto TEXT,
        timestamp TEXT NOT NULL,
        created_at TEXT NOT NULL DEFAULT (datetime('now'))
      )
    `)

    esperar db.execute(`
      CREATE INDEX IF NOT EXISTS idx_fci_variables_fondo ON fci_variables(fondo)
    `)

    esperar db.execute(`
      CREATE INDEX IF NOT EXISTS idx_fci_variables_timestamp ON fci_variables(timestamp)
    `)

    esperar db.execute(`
      CREATE INDEX IF NOT EXISTS idx_fci_variables_fecha ON fci_variables(fecha)
    `)

    consola.escribir('Migración 001 completada: esquema inicial creado exitosamente')
  },

  asincrono down(db) {
    consola.escribir('Revirtiendo migración 001: eliminando tabla fci_variables...')

    esperar db.execute('DROP INDEX IF EXISTS idx_fci_variables_fecha')
    esperar db.execute('DROP INDEX IF EXISTS idx_fci_variables_timestamp')
    esperar db.execute('DROP INDEX IF EXISTS idx_fci_variables_fondo')
    esperar db.execute('DROP TABLE IF EXISTS fci_variables')

    consola.escribir('Migración 001 revertida: tabla eliminada')
  },
}
