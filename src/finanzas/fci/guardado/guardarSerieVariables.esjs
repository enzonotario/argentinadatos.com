importar { FciVariablesDatabaseService } desde '../databaseVariables/service.esjs'
importar { escribirRuta } desde '@/utils/rutas.esjs'

const TURSO_DATABASE_URL = import.meta.env.VITE_TURSO_DATABASE_URL
const TURSO_AUTH_TOKEN = import.meta.env.VITE_TURSO_AUTH_TOKEN

funcion normalizarNombreFondo(nombre) {
  retornar nombre.aMinusculas()
    .replace(/\s+/g, '-').reemplazar(/[^a-z0-9-]/g, '');
}

exportar asincrono funcion guardarSerieVariables(
  items,
  url = TURSO_DATABASE_URL,
  authToken = TURSO_AUTH_TOKEN,
) {
  const db = crear FciVariablesDatabaseService(url, authToken)

  intentar {
    esperar db.initialize()

    const timestamp = crear Fecha().aCadenaISO()
    const itemsToInsert = []

    para (const item de items) {
      const ultimo = esperar db.getLatestFciVariablesByNombre(item.nombre)

      const valoresCambiaron =
        ultimo &&
        (ultimo.tna !== item.tna ||
          ultimo.fondo !== (item.fondo || nulo) ||
          ultimo.tipo !== (item.tipo || nulo) ||
          ultimo.tea !== item.tea ||
          ultimo.tope !== item.tope ||
          ultimo.condiciones !== (item.condiciones || nulo) ||
          ultimo.condicionesCorto !== (item.condicionesCorto || nulo))

      si (!ultimo || (valoresCambiaron && item.fecha > ultimo.fecha)) {
        itemsToInsert.agregar(item)
        esperar db.insertFciVariables(
          item.nombre,
          item.fondo,
          item.tipo || nulo,
          item.tna,
          item.tea,
          item.tope || nulo,
          item.fecha,
          item.condiciones || nulo,
          item.condicionesCorto || nulo,
          timestamp,
        )
      }
    }

    si (itemsToInsert.longitud > 0) {
      consola.escribir(
        `Guardados ${itemsToInsert.longitud} nuevos valores de FCI variables`,
      )
    }

    esperar generarEndpointsEstaticos(db)
  } finalmente {
    db.close()
  }
}

asincrono funcion generarEndpointsEstaticos(db) {
  const todosLosDatos = esperar db.getAllLatestFciVariables()

  const resultado = todosLosDatos.mapear(row => ({
    nombre: row.nombre,
    fondo: row.fondo,
    tipo: row.tipo,
    tna: row.tna,
    tea: row.tea,
    tope: row.tope,
    fecha: row.fecha,
    condiciones: row.condiciones,
    condicionesCorto: row.condicionesCorto,
  }))

  escribirRuta('/finanzas/fci/variables/ultimo', resultado)

  const penultimo = esperar db.getPenultimoFciVariables()
  const penultimoResultado = penultimo.mapear(row => ({
    nombre: row.nombre,
    fondo: row.fondo,
    tipo: row.tipo,
    tna: row.tna,
    tea: row.tea,
    tope: row.tope,
    fecha: row.fecha,
    condiciones: row.condiciones,
    condicionesCorto: row.condicionesCorto,
  }))

  si (penultimoResultado.longitud > 0) {
    escribirRuta('/finanzas/fci/variables/penultimo', penultimoResultado)
  }

  const nombres = esperar db.getAllNombres()

  para (const nombre de nombres) {
    const historial = esperar db.getHistorialPorNombre(nombre)
    const historialResultado = historial.mapear(row => ({
      nombre: row.nombre,
      fondo: row.fondo,
      tna: row.tna,
      tipo: row.tipo,
      tea: row.tea,
      tope: row.tope,
      fecha: row.fecha,
      condiciones: row.condiciones,
      condicionesCorto: row.condicionesCorto,
    })).filtrar((item, index, arr) => {
      si (index === 0) retornar verdadero
      const prev = arr[index - 1]
      retornar (
        item.nombre !== prev.nombre ||
        item.fondo !== prev.fondo ||
        item.tna !== prev.tna ||
        item.tipo !== prev.tipo ||
        item.tea !== prev.tea ||
        item.tope !== prev.tope ||
        item.condiciones !== prev.condiciones ||
        item.condicionesCorto !== prev.condicionesCorto
      )
    })

    const nombreNormalizado = normalizarNombreFondo(nombre)
    escribirRuta(`/finanzas/fci/variables/${nombreNormalizado}`, historialResultado)
  }
}
