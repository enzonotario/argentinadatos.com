importar { format, parse } desde 'date-fns'
importar { logGrupo, logError, logMensaje } desde '@/log.esjs'
importar { construirRequestConProxy } desde '@/utils/proxy.esjs'

exportar asincrono funcion extraerGlobal66CuentaRemunerada() {
  const log = logGrupo({
    fuente: 'extraerGlobal66',
    tipo: 'cuentaRemunerada',
  })

  intentar {
    const apiUrl = import.meta.env.VITE_GLOBAL66_API_URL
    const apiKey = import.meta.env.VITE_GLOBAL66_API_KEY

    si (!apiUrl || !apiKey) {
      logMensaje(log, 'Faltan VITE_GLOBAL66_API_URL o VITE_GLOBAL66_API_KEY')
      retornar []
    }

    const request = construirRequestConProxy(apiUrl, {
      method: 'GET',
      headers: {
        'x-api-key': apiKey,
        'Content-Type': 'application/json',
      },
    })

    si (request.usaProxy) {
      logMensaje(log, 'Consultando Global66 via proxy')
    }

    const respuesta = esperar fetch(request.url, request.opciones)

    si (!respuesta.ok) {
      logMensaje(log, 'Respuesta no OK de Global66 API', {
        status: respuesta.status,
        statusText: respuesta.statusText,
      })
      lanzar crear Error(
        `Error en la solicitud a Global66 API: ${respuesta.status} ${respuesta.statusText}`,
      )
    }

    const datos = esperar respuesta.json()

    si (!datos || datos.tna === nulo || datos.tna === indefinido) {
      logMensaje(log, 'Datos inválidos de Global66 API', { datos })
      lanzar crear Error('Error en la respuesta de Global66 API')
    }

    const tna = Numero((Numero(datos.tna) / 100).fijarDecimales(4))
    const tea = Numero(((1 + tna / 365) ** 365 - 1).fijarDecimales(4))

    var fecha = format(crear Fecha(), 'yyyy-MM-dd')
    si (datos.fecha) {
      intentar {
        fecha = format(
          parse(datos.fecha, 'dd-MM-yyyy', crear Fecha()),
          'yyyy-MM-dd',
        )
      } capturar {
        // Si falla el parseo de fecha, se mantiene la fecha actual.
      }
    }

    retornar {
      nombre: 'GLOBAL66',
      fondo: 'Compass Liquidez - Clase A',
      tipo: 'billetera',
      tna,
      tea,
      tope: datos.tope || nulo,
      fecha,
      condiciones: datos.condiciones || nulo,
      condicionesCorto: datos.condicionesCorto || nulo,
    };
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}
