importar { Defuddle } desde 'defuddle/node'

/**
 * Convierte HTML en markdown usando el paquete Defuddle (entorno Node).
 * @see https://defuddle.md/docs
 */
exportar asincrono funcion htmlAMarkdownConDefuddle(html, pageUrl) {
  si (!html || html.recortarEspacios() === '') {
    lanzar crear Error('html vacío para Defuddle')
  }

  const resultado = esperar Defuddle(html, pageUrl, { markdown: verdadero })
  const md = resultado.content

  si (!md || md.recortarEspacios() === '') {
    lanzar crear Error(`Defuddle no devolvió contenido markdown para ${pageUrl}`)
  }

  retornar md
}

exportar asincrono funcion obtenerMarkdownDefuddleDesdeUrl(pageUrl) {
  const respuesta = esperar fetch(pageUrl, { method: 'GET' })

  si (!respuesta.ok) {
    lanzar crear Error(
      `Error obteniendo HTML para Defuddle: ${respuesta.status} ${respuesta.statusText}. URL: ${pageUrl}`,
    )
  }

  const html = esperar respuesta.text()
  retornar esperar htmlAMarkdownConDefuddle(html, pageUrl)
}
