importar axios desde 'axios'
importar { load } desde 'cheerio'
importar { logGrupo, logError } desde '@/log.esjs'

const log = logGrupo({
  fuente: 'extraerPlazoFijoPrecancelable',
  tipo: 'extraccion',
})

exportar asincrono funcion extraerPlazoFijoPrecancelable() {
  intentar {
    const proveedores = [
      ...(esperar extraerBna()),
      ...(esperar extraerBbva()),
      ...(esperar extraerProvincia()),
    ]

    retornar proveedores
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

asincrono funcion extraerBna() {
  intentar {
    const enlace = 'https://www.bna.com.ar/personas/plazofijoprecancelableuva'
    const respuesta = esperar axios.get(enlace)
    const $ = load(respuesta.data)
    const texto = $('body').text().reemplazar(/\s+/g, ' ')
    const rangoTasas = texto.coincidir(
      /De\s+(\d+)\s+a\s+(\d+)\s+([\d,.]+)%[^\d]+([\d,.]+)%/,
    )
    const tasaPrecancelacion = texto.coincidir(
      /Cancelaciones anticipadas.*?TNA:\s*([\d,.]+)%.*?TEA:\s*([\d,.]+)%/i,
    )

    retornar [
      {
        id: 'bna',
        entidad: 'Banco de la Nación Argentina',
        logo: 'https://www.bna.com.ar/Content/img/logo-bna.png',
        enlace,
        canal: 'App BNA+, Home Banking y sucursales',
        moneda: 'ARS',
        plazoMinDias:
          extraerEntero(texto, /Plazo mínimo:\s*(\d+)\s*días/i) || 180,
        plazoMaxDias:
          extraerEntero(texto, /Plazo máximo:\s*(\d+)\s*días/i) || 370,
        plazoPrecancelacionDias:
          extraerEntero(texto, /Transcurrido\s+(\d+)\s+días/i) || 30,
        avisoPrecancelacionDias:
          extraerEntero(texto, /anticipación de\s+(\d+)\s+días hábiles/i) || 5,
        montoMinimo: extraerMonto(texto, /Monto mínimo:\s*\$?\s*([\d.]+)/i),
        montoMaximo: extraerMonto(
          texto,
          /tope de\s*\$?\s*([\d.]+)\s*millones/i,
          1000000,
        ),
        modalidad: extraerValor(texto, /Modalidad:\s*([^\.]+)/i),
        tna: rangoTasas ? parsearPorcentaje(rangoTasas[3]) : nulo,
        tea: rangoTasas ? parsearPorcentaje(rangoTasas[4]) : nulo,
        tnaPrecancelacion: tasaPrecancelacion
          ? parsearPorcentaje(tasaPrecancelacion[1])
          : nulo,
        teaPrecancelacion: tasaPrecancelacion
          ? parsearPorcentaje(tasaPrecancelacion[2])
          : nulo,
      },
    ]
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

asincrono funcion extraerBbva() {
  intentar {
    const enlace =
      'https://www.bbva.com.ar/economia-para-tu-dia-a-dia/ef/plazos-fijos/que-es-plazo-fijo-uva.html'
    const respuesta = esperar axios.get(enlace)
    const $ = load(respuesta.data)
    const texto = $('body').text().reemplazar(/\s+/g, ' ')

    retornar [
      {
        id: 'bbva',
        entidad: 'BBVA Banco Argentina',
        logo: 'https://www.bbva.com.ar/content/dam/public-web/global/images/logos/logo_bbva.svg',
        enlace,
        canal: nulo,
        moneda: 'ARS',
        plazoMinDias: 180,
        plazoMaxDias: nulo,
        plazoPrecancelacionDias:
          extraerEntero(texto, /a partir de los\s+(\d+)\s+días/i) || 31,
        avisoPrecancelacionDias: nulo,
        montoMinimo: nulo,
        montoMaximo: nulo,
        modalidad: nulo,
        tna: extraerPorcentaje(texto, /UVA \+ TNA del\s+([\d,.]+)%/i),
        tea: nulo,
        tnaPrecancelacion: nulo,
        teaPrecancelacion: nulo,
      },
    ]
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

asincrono funcion extraerProvincia() {
  intentar {
    const enlace =
      'https://www.bancoprovincia.com.ar/mvc/productos/inversiones/Plazo_Fijo_uva_cancel_ant/Plazo_Fijo_uva_ca_info_gral'
    const respuesta = esperar axios.get(enlace)
    const $ = load(respuesta.data)
    const texto = $('body').text().reemplazar(/\s+/g, ' ')

    retornar [
      {
        id: 'banco-provincia',
        entidad: 'Banco de la Provincia de Buenos Aires',
        logo: 'https://www.bancoprovincia.com.ar/CDN/Get/logo_2021.svg',
        enlace,
        canal: extraerValor(texto, /Canal:\s*([^]+?)\s+Plazo:/i),
        moneda: 'ARS',
        plazoMinDias:
          extraerEntero(texto, /Plazo:\s*mínimo\s+(\d+)\s+días/i) ||
          extraerEntero(texto, /mínimo de\s+(\d+)\s+días/i) ||
          90,
        plazoMaxDias: nulo,
        plazoPrecancelacionDias:
          extraerEntero(texto, /a partir del día\s+(\d+)/i) || 30,
        avisoPrecancelacionDias: nulo,
        montoMinimo: extraerMonto(texto, /Monto inicial:\s*\$?\s*([\d.]+)/i),
        montoMaximo: nulo,
        modalidad: extraerValor(texto, /CARÁCTER\s+([^]+?)\s+SIN RENOVACIÓN/i),
        tna: extraerPorcentaje(texto, /TNAV:\s*([\d,.]+)%/i),
        tea: extraerPorcentaje(texto, /TEAV\)\s*([\d,.]+)%/i),
        tnaPrecancelacion: extraerPorcentaje(
          texto,
          /tasa fija de precancelación del\s+([\d,.]+)%/i,
        ),
        teaPrecancelacion: nulo,
      },
    ]
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

funcion extraerEntero(texto, patron) {
  const coincidencia = texto.coincidir(patron)
  si (!coincidencia) retornar nulo
  const numero = Numero.interpretarEntero(coincidencia[1], 10)
  retornar Numero.esNan(numero) ? nulo : numero;
}

funcion extraerMonto(texto, patron, multiplicador = 1) {
  const coincidencia = texto.coincidir(patron)
  si (!coincidencia) retornar nulo
  const numero = Numero.interpretarEntero(coincidencia[1].reemplazar(/\./g, ''), 10)
  retornar Numero.esNan(numero) ? nulo : numero * multiplicador;
}

funcion extraerValor(texto, patron) {
  const coincidencia = texto.coincidir(patron)
  si (!coincidencia) retornar nulo
  const valor = coincidencia[1].reemplazar(/\s+/g, ' ').recortarEspacios()
  retornar valor || nulo
}

funcion extraerPorcentaje(texto, patron) {
  const coincidencia = texto.coincidir(patron)
  retornar coincidencia ? parsearPorcentaje(coincidencia[1]) : nulo
}

funcion parsearPorcentaje(valor) {
  si (!valor) retornar nulo
  const limpio = valor.replace('%', '').reemplazar(',', '.').recortarEspacios()
  const numero = Numero.interpretarDecimal(limpio)
  retornar Numero.esNan(numero) ? nulo : numero / 100;
}
