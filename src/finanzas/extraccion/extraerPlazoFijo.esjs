importar axios desde 'axios'
importar { extraerUalaPlazoFijo } desde '@/finanzas/extraccion/extraerUala.esjs'

const URL_PLAZOS_FIJOS_BCRA =
  'https://www.bcra.gob.ar/api/endpoints/plazos-fijos.php'

funcion tnaDesdePorcentajeBcra(valor) {
  si (valor === nulo || valor === indefinido) {
    retornar nulo
  }
  si (tipoDe valor !== 'number' || isNaN(valor)) {
    retornar nulo
  }
  retornar valor / 100
}

exportar asincrono funcion extraerPlazoFijo() {
  intentar {
    const tasas = [...(esperar obtenerRespuesta()), esperar extraerUalaPlazoFijo()]

    retornar tasas
  } capturar (error) {
    consola.error('Error al extraer tasas de plazo fijo', error)
  }
}

exportar asincrono funcion obtenerRespuesta() {
  intentar {
    const respuesta = esperar axios.get(URL_PLAZOS_FIJOS_BCRA)
    const datos = respuesta.data

    si (!datos || !datos.success) {
      consola.error('Respuesta inválida de plazos fijos BCRA', { datos })
      retornar []
    }

    const top10 = datos.top10 || []
    const otros = datos.otros || []

    retornar [...top10, ...otros].mapear(item => ({
      entidad: item.entidad.recortarEspacios(),
      logo: item.logo_url,
      tnaClientes: tnaDesdePorcentajeBcra(item.tasa_con_relacion),
      tnaNoClientes: tnaDesdePorcentajeBcra(item.tasa_sin_relacion),
      enlace: item.web || nulo,
    }));
  } capturar (error) {
    consola.error('Error al obtener respuesta de tasas de plazo fijo', error)
    retornar []
  }
}
