importar axios desde 'axios'
importar { extraerUalaPlazoFijo } desde '@/finanzas/extraccion/extraerUala.esjs'

exportar asincrono funcion extraerPlazoFijo() {
  intentar {
    const tasas = [...(esperar obtenerRespuesta()), esperar extraerUalaPlazoFijo()]

    retornar tasas
  } capturar (error) {
    consola.error('Error al extraer tasas de plazo fijo', error)
  }
}

exportar asincrono funcion obtenerRespuesta() {
  intentar {
    const respuesta = esperar axios.get(
      'https://www.bcra.gob.ar/api-plazos-fijos.php',
    )
    const { top10, otros } = respuesta.data

    retornar [...top10, ...otros].mapear(item => ({
      entidad: item.entidad.recortarEspacios(),
      logo: item.logo_url,
      tnaClientes: item.tasa_con_relacion ? item.tasa_con_relacion / 100 : nulo,
      tnaNoClientes: item.tasa_sin_relacion
        ? item.tasa_sin_relacion / 100
        : nulo,
      enlace: item.web || nulo,
    }));
  } capturar (error) {
    consola.error('Error al obtener respuesta de tasas de plazo fijo', error)
    retornar []
  }
}
