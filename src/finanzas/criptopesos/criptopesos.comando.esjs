importar { extraerBelo } desde '@/finanzas/criptopesos/extraccion/extraerBelo.esjs'
importar { extraerCapyfi } desde '@/finanzas/criptopesos/extraccion/extraerCapyfi.esjs'
importar { extraerRipio } desde '@/finanzas/criptopesos/extraccion/extraerRipio.esjs'
importar { guardarCriptopesos } desde '@/finanzas/criptopesos/guardado/guardarCriptopesos.esjs'

exportar asincrono funcion ejecutarCriptopesos() {
  intentar {
    const [belo, capyfi, ripio] = esperar Promise.all([
      extraerBelo(),
      extraerCapyfi(),
      extraerRipio(),
    ])
    const datos = [...belo, ...capyfi, ...ripio]

    esperar guardarCriptopesos(datos)
  } capturar (error) {
    consola.error('Error al extraer criptopesos', error)
  }
}

exportar porDefecto ejecutarCriptopesos
