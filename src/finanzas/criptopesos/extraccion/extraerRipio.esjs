importar { logGrupo, logError, logMensaje } desde '@/log.esjs'
importar axios desde 'axios'
importar { collect } desde 'collect.js'
importar { apyToTna } desde '@/finanzas/criptopesos/apyToTna.esjs'

exportar asincrono funcion extraerRipio() {
  const log = logGrupo({
    fuente: 'extraerRipio',
    tipo: 'criptopesos',
  })

  intentar {
    const url = import.meta.env.VITE_FINANZAS_RENDIMIENTOS_RIPIO_URL
    si (!url) {
      logMensaje(log, 'Falta VITE_FINANZAS_RENDIMIENTOS_RIPIO_URL')
      retornar []
    }

    const respuesta = esperar axios.get(url)

    si (
      !respuesta.data ||
      !respuesta.data.results ||
      !respuesta.data.results.longitud
    ) {
      logMensaje(log, 'Respuesta vacía o sin results de Ripio API', {
        datos: respuesta.data,
      })
      retornar []
    }

    const warsItems = collect(respuesta.data.results).planoMapear(protocolo =>
        protocolo.assets.filtrar(
            asset => asset.currency && asset.currency.aMayusculas() === 'WARS',
          ).mapear(asset => {
            const apy = Numero(asset.apy) || 0
            const tarifaGestion =
              asset.fees && asset.fees.service ? asset.fees.service : 0
            retornar {
              apy: calcularApy(apy, tarifaGestion),
            }
          }),
      )
      .toArray()

    si (warsItems.longitud === 0) {
      logMensaje(log, 'No se encontró wARS en Ripio API', {
        datos: respuesta.data,
      })
      retornar []
    }

    const maximoApy = collect(warsItems).sortByDesc('apy').first().apy
    const apyDecimal = maximoApy / 100

    const segundosPorAnio = 365 * 24 * 60 * 60
    const slotSeconds = 12.04
    const n = segundosPorAnio / slotSeconds

    const tnaCalculada = apyToTna(apyDecimal, n)
    const tna = Numero(tnaCalculada.fijarDecimales(4))

    si (isNaN(tna) || tna < 0) {
      lanzar crear Error('Valor de TNA inválido para Ripio wARS')
    }

    retornar [
      {
        token: 'wARS',
        entidad: 'RIPIO',
        tna,
      },
    ]
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}

exportar funcion calcularApy(apy, tarifaGestion) {
  const factorAnualBruto = 1 + apy / 100
  const factorFeeAnual = Mate.potencia(1 - tarifaGestion / 100, 365)
  const factorAnualNeto = factorAnualBruto * factorFeeAnual
  retornar Numero(((factorAnualNeto - 1) * 100).fijarDecimales(2));
}
