importar { logGrupo, logError, logMensaje } desde '@/log.esjs'
importar axios desde 'axios'

exportar asincrono funcion extraerCapyfi() {
  const log = logGrupo({
    fuente: 'extraerCapyfi',
    tipo: 'criptopesos',
  })

  intentar {
    const baseUrl = import.meta.env.VITE_FINANZAS_CAPYFI_API_URL
    const token = import.meta.env.VITE_FINANZAS_CAPYFI_TOKEN
    const chainId = import.meta.env.VITE_FINANZAS_CAPYFI_CHAIN_ID || '1'
    const cTokenAddress =
      import.meta.env.VITE_FINANZAS_CAPYFI_CTOKEN_ADDRESS ||
      '0xf80eeec09f417Fa7FCc4A848Ef03af9dF2658d7B'

    si (!baseUrl || !token) {
      logMensaje(
        log,
        'Faltan VITE_FINANZAS_CAPYFI_API_URL o VITE_FINANZAS_CAPYFI_TOKEN',
      )
      retornar []
    }

    const url = `${baseUrl}?chainId=${chainId}&cTokenAddress=${encodeURIComponent(cTokenAddress)}`

    const respuesta = esperar axios.get(url, {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    })

    si (!respuesta || !respuesta.data) {
      logMensaje(log, 'Respuesta vacía de Capyfi API', {
        datos: respuesta ? respuesta.data : indefinido,
      })
      lanzar crear Error('Error en la respuesta de Capyfi API')
    }

    const data = respuesta.data
    mut apyRaw = data.totalApy
    si (apyRaw === indefinido || apyRaw === nulo) apyRaw = data.baseApy
    si (apyRaw === indefinido || apyRaw === nulo) apyRaw = data.apy
    si (apyRaw === indefinido || apyRaw === nulo) apyRaw = data.supplyApy
    si (apyRaw === indefinido || apyRaw === nulo) apyRaw = data.supply_apy
    si (apyRaw === indefinido || apyRaw === nulo) apyRaw = data.marketApy
    si (apyRaw === indefinido || apyRaw === nulo) apyRaw = data.market_apy

    si (apyRaw === indefinido || apyRaw === nulo) {
      logMensaje(log, 'Datos inválidos de Capyfi API: no se encontró APY', {
        datos: data,
      })
      lanzar crear Error('Error en la respuesta de Capyfi API: APY no encontrado')
    }

    mut tna = Numero(apyRaw)
    si (tna > 1) {
      tna = tna / 100
    }

    si (isNaN(tna) || tna < 0) {
      lanzar crear Error('Valor de APY/TNA inválido')
    }

    retornar [
      {
        token: 'wARS',
        entidad: 'CAPYFI',
        tna: Numero(tna.fijarDecimales(4)),
      },
    ];
  } capturar (error) {
    logError(log, error)
    retornar []
  }
}
