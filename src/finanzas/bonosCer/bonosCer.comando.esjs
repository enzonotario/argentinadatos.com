importar { extraerBonosCer } desde '@/finanzas/bonosCer/extraccion/extraerBonosCer.esjs'
importar { guardarBonosCer } desde '@/finanzas/bonosCer/guardado/guardarBonosCer.esjs'

exportar asincrono funcion ejecutarBonosCer() {
  intentar {
    const datos = esperar extraerBonosCer()
    esperar guardarBonosCer(datos)
  } capturar (error) {
    consola.error('Error al extraer bonos CER', error)
  }
}

exportar porDefecto ejecutarBonosCer
