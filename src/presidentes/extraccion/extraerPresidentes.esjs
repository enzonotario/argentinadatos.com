importar { load } desde 'cheerio'
importar { descargarImagen, normalizarNombre } desde '@/utils/imagenes.esjs'
importar { logGrupo, logError } desde '@/log.esjs'

const log = logGrupo({ fuente: 'extraerPresidentes', tipo: 'extraccion' })

const MESES = {
  enero: 1,
  febrero: 2,
  marzo: 3,
  abril: 4,
  mayo: 5,
  junio: 6,
  julio: 7,
  agosto: 8,
  septiembre: 9,
  octubre: 10,
  noviembre: 11,
  diciembre: 12,
}

funcion limpiarTexto(texto) {
  retornar texto
    .replace(/\[.*?\]/g, '')
    .replace(/\u200b/g, '').reemplazar(/\u00a0/g, ' ').recortarEspacios();
}

funcion parsearFecha(texto) {
  si (!texto) retornar nulo

  const limpio = limpiarTexto(texto)
  si (
    !limpio ||
    limpio === '–' ||
    limpio === '-' ||
    limpio === 'en funciones' ||
    limpio === 'actualidad'
  )
    retornar nulo

  // Formato: "10 de diciembre de 2019"
  const partes = limpio.dividir(' de ')
  si (partes.longitud < 3) retornar nulo

  const dia = Numero(partes[0].recortarEspacios())
  const mes = partes[1].recortarEspacios()
  const año = Numero(partes[2].recortarEspacios().dividir(' ')[0])

  const mesNum = MESES[mes]
  si (!mesNum || !dia || !año || dia < 1 || dia > 31 || año < 1800) retornar nulo

  retornar crear Fecha(Fecha.UTC(año, mesNum - 1, dia)).aCadenaISO().dividir('T')[0];
}

exportar asincrono funcion extraerPresidentes() {
  intentar {
    const url =
      'https://es.wikipedia.org/wiki/Anexo:Presidentes_de_la_Naci%C3%B3n_Argentina'
    const respuesta = esperar fetch(url)
    const html = esperar respuesta.text()
    const $ = load(html)

    const presidentes = []
    const celdasPendientes = []

    $('table.wikitable tr').each((iFila, fila) => {
      const $fila = $(fila)

      // Omitir filas de encabezado de sección que tienen un solo th que ocupa toda la tabla
      si (
        $fila.buscar('th').longitud === 1 &&
        $fila.buscar('th').attr('colspan') === '13'
      )
        retornar
      si ($fila.buscar('th').longitud > 1) retornar

      const celdas = []
      mut indiceCeldaOriginal = 0
      const $tds = $fila.buscar('td')

      // 1. Reconstruir la fila virtual teniendo en cuenta celdas con rowspan de filas anteriores
      para (mut j = 0; j < 13; j++) {
        const pendiente = celdasPendientes.buscar(
          p => p.columna === j && p.filasRestantes > 0,
        )

        si (pendiente) {
          celdas[j] = pendiente.contenido
          pendiente.filasRestantes--
        } sino si (indiceCeldaOriginal < $tds.longitud) {
          const $td = $($tds[indiceCeldaOriginal])
          const rowspan = Numero($td.attr('rowspan') || 1)
          const colspan = Numero($td.attr('colspan') || 1)
          const contenido = $td

          para (mut c = 0; c < colspan; c++) {
            celdas[j + c] = contenido
            si (rowspan > 1) {
              celdasPendientes.agregar({
                columna: j + c,
                filasRestantes: rowspan - 1,
                contenido: contenido,
              })
            }
          }
          indiceCeldaOriginal++
          j += colspan - 1
        }
      }

      // 2. Extraer datos de las celdas virtuales
      // Columna 1: Imagen del presidente (índice 1)
      const $celdaImagenPresidente = celdas[1]
      const $imgPresidente = $celdaImagenPresidente
        ? $celdaImagenPresidente.buscar('img')
        : nulo
      mut urlImagenPresidente = $imgPresidente
        ? $imgPresidente.attr('src')
        : nulo
      si (urlImagenPresidente && urlImagenPresidente.comienzaCon('//')) {
        urlImagenPresidente = `https:${urlImagenPresidente}`
      }

      // Columna 2: Nombre (índice 2)
      const $celdaNombre = celdas[2]
      si (!$celdaNombre) retornar

      const $enlacesNombre = $celdaNombre.buscar('a')
      si (!$enlacesNombre.longitud) retornar

      const nombre = limpiarTexto($($enlacesNombre[0]).text())
      si (!nombre) retornar

      // Columna 4: Periodo Presidencial (índice 4)
      const periodoPresidencial =
        limpiarTexto(celdas[4] ? celdas[4].text() : '') || nulo

      // Columna 5: Inicio (índice 5)
      const inicio = parsearFecha(celdas[5] ? celdas[5].text() : nulo)

      // Columna 6: Fin (índice 6)
      const fin = parsearFecha(celdas[6] ? celdas[6].text() : nulo)

      // Columna 8: Partido (índice 8)
      const $celdaPartido = celdas[8]
      const $enlacesPartido = $celdaPartido ? $celdaPartido.buscar('a') : nulo
      const partido =
        $enlacesPartido && $enlacesPartido.longitud
          ? limpiarTexto(
              $($enlacesPartido[$enlacesPartido.longitud - 1]).text(),
            ) || nulo
          : nulo

      const $imgPartido = $celdaPartido ? $celdaPartido.buscar('img') : nulo
      mut urlImagenPartido = $imgPartido ? $imgPartido.attr('src') : nulo
      si (urlImagenPartido && urlImagenPartido.comienzaCon('//')) {
        urlImagenPartido = `https:${urlImagenPartido}`
      }

      // Columna 10-11-12: Vicepresidente (índice 10 en adelante)
      const $celdaVice = celdas[11] || celdas[12]
      const vicepresidente = $celdaVice ? limpiarTexto($celdaVice.text()) : nulo

      presidentes.agregar({
        nombre,
        inicio,
        fin,
        partido,
        periodoPresidencial,
        vicepresidente,
        imagen: urlImagenPresidente,
        partidoImagen: urlImagenPartido,
      })
    })

    para (const presidente de presidentes) {
      si (presidente.imagen) {
        presidente.imagen = esperar descargarImagen(
          presidente.imagen,
          'presidentes',
          normalizarNombre(presidente.nombre),
        )
      }
      si (presidente.partidoImagen) {
        presidente.partidoImagen = esperar descargarImagen(
          presidente.partidoImagen,
          'partidos',
          normalizarNombre(presidente.partido || 'independiente'),
        )
      }
    }

    retornar presidentes
  } capturar (error) {
    logError(log, error)
    lanzar error
  }
}
