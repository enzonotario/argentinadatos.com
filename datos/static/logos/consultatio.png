<script type="text/javascript">
$(function() {
    window.onbeforeunload = null;
    $("#marketplace_form").on("submit", function(e) {
    	e.preventDefault();
    	ambientes = ($("#ambientes").val()) ? $("#ambientes").val() : "";
    	tipo_propiedad = ($("#tipo_propiedad").val()) ? $("#tipo_propiedad").val() : "";
    	proyecto = ($("#proyecto").val()) ? $("#proyecto").val() : "";
    	barrio = ($("#barrio").val()) ? $("#barrio").val() : "";
    	url = "https://dev.consultatio.com.ar/marketplace/inmuebles/-"+ambientes+"-"+tipo_propiedad+"-proyecto-"+proyecto+"-barrio-"+barrio;
    	window.open(url, '_blank');
    });
});
</script>
