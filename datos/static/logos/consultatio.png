<script>
var velocity = 0.5;
function update(){ 
    var pos = $(window).scrollTop(); 
    $('.parallax-scroll').each(function() { 
        var $element = $(this);
        var height = $element.height();
        $(this).css('backgroundPosition', '70% ' + Math.round((height - pos) * velocity) + 'px'); 
    }); 
};

$(window).bind('scroll', update);
</script>
