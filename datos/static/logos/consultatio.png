<script>
$(function(){
$("#btn-play[data-controls]").click(function(){
var data=$(this).data();
$("#"+data.controls)[0][data.command]();
})
$("#btn-fullscreen[data-controls]").click(function(){
var data=$(this).data();
$("#"+data.controls)[0].webkitEnterFullScreen();
})
$("#btn-pause[data-controls]").click(function(){
var data=$(this).data();
console.log(data);
$("#"+data.controls)[0].pause();
})
$('#btn-play, #btn-pause').on('click', function() {
				$('.show, .hide').toggle();
			});
});
$('#play-video').on('click', function() {
	$('#btn-play,#btn-fullscreen').click();
	//console.log("play-video")
});
</script>





<script>
var map;

/**
* The ZoomControl adds +/- button for the map
*
*/
function ZoomControl(controlDiv, map) {

// Creating divs & styles for custom zoom control
controlDiv.style.padding = '2rem';
// Set CSS for the control wrapper
var controlWrapper = document.createElement('div');
controlWrapper.style.backgroundColor = 'transparent';
controlWrapper.style.cursor = 'pointer';
controlWrapper.style.textAlign = 'center';
controlWrapper.style.width = '2rem';
controlWrapper.style.height = '4rem';
controlDiv.appendChild(controlWrapper);

// Set CSS for the zoomIn
var zoomInButton = document.createElement('div');
zoomInButton.style.width = '2rem';
zoomInButton.style.height = '2rem';
zoomInButton.style.marginBottom = '.5rem';
/* Change this to be the .png image you want to use */
zoomInButton.style.backgroundImage = 'url("https://www.consultatio.com.ar/assets/img/zoom-in.svg")';
controlWrapper.appendChild(zoomInButton);

// Set CSS for the zoomOut
var zoomOutButton = document.createElement('div');
zoomOutButton.style.width = '2rem';
zoomOutButton.style.height = '2rem';
/* Change this to be the .png image you want to use */
zoomOutButton.style.backgroundImage = 'url("https://www.consultatio.com.ar/assets/img/zoom-out.svg")';
controlWrapper.appendChild(zoomOutButton);
// Setup the click event listener - zoomIn
google.maps.event.addDomListener(zoomInButton, 'click', function() {
map.setZoom(map.getZoom() + 1);
});

// Setup the click event listener - zoomOut
google.maps.event.addDomListener(zoomOutButton, 'click', function() {
map.setZoom(map.getZoom() - 1);
});

}
