{
  "name": "esjs-argentina-datos-api",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enzonotario/esjs-argentina-datos-api.git"
  },
  "author": "Enzo Notario <hi@enzonotario.me>",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22 <23"
  },
  "volta": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run cron:build",
    "cron": "pnpm run cron:run",
    "cron:build": "vite build --ssr --mode=production",
    "cron:run": "node ./dist/index.js",
    "test": "node scripts/ensure-better-sqlite3.mjs && vitest tests --run",
    "docs:dev": "cd docs && pnpm run dev",
    "docs:build": "cd docs && pnpm run build",
    "docs:preview": "cd docs && pnpm run preview",
    "api:dev": "vite --config vite.api.config.js --host",
    "api:build": "vite build --config vite.api.config.js --ssr --mode=production",
    "format": "prettier --write src tests apps",
    "senado:test": "cd packages/senado && pnpm test",
    "senado:test:run": "cd packages/senado && pnpm run test:run",
    "diputados:test": "cd packages/diputados && pnpm test",
    "diputados:test:run": "cd packages/diputados && pnpm run test:run",
    "cafci-worker:crawl": "pnpm --filter @argentinadatos/cafci-worker crawl",
    "cafci-worker:process-jobs": "pnpm --filter @argentinadatos/cafci-worker process-jobs",
    "cafci-worker:test": "node scripts/ensure-better-sqlite3.mjs && vitest run tests/cafci-worker",
    "cafci-worker:start": "pnpm --filter @argentinadatos/cafci-worker start",
    "cafci-worker:r2:backup": "pnpm --filter @argentinadatos/cafci-worker r2:backup",
    "cafci-worker:r2:download": "pnpm --filter @argentinadatos/cafci-worker r2:download",
    "cafci-worker:db:jobs-stats": "pnpm --filter @argentinadatos/cafci-worker db:jobs-stats",
    "cafci-worker:db:clear-jobs": "pnpm --filter @argentinadatos/cafci-worker db:clear-jobs",
    "cafci-worker:db:rebuild-from-static": "pnpm --filter @argentinadatos/cafci-worker db:rebuild-from-static",
    "migrate": "node scripts/migrate.js",
    "seed:fci-otros": "node scripts/seed-fci-otros.js"
  },
  "devDependencies": {
    "@es-js/vite-plugin-esjs": "^0.1.0-beta.2",
    "@hono/vite-dev-server": "^0.23.0",
    "axios": "^1.13.2",
    "cheerio": "1.0.0-rc.12",
    "collect.js": "^4.36.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "fs": "0.0.1-security",
    "glob": "^13.0.0",
    "hono": "^4.10.7",
    "parse-decimal-number": "^1.0.0",
    "path": "^0.12.7",
    "pino": "^10.1.0",
    "pino-axiom": "^1.0.432",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.3",
    "prettier-plugin-esjs": "^0.1.0-beta.2",
    "sitemap": "^9.0.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "endOfLine": "auto"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "better-sqlite3": "^12.5.0",
    "db-static-api": "0.0.1-alpha.0",
    "defuddle": "^0.18.1",
    "xlsx": "^0.18.5"
  }
}
