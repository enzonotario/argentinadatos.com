{
  "name": "esjs-argentina-datos-api",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enzonotario/esjs-argentina-datos-api.git"
  },
  "author": "Enzo Notario <hi@enzonotario.me>",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23"
  },
  "volta": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run cron:build",
    "cron": "pnpm run cron:run",
    "cron:build": "vite build --ssr --mode=production",
    "cron:run": "node ./dist/index.js",
    "test": "node scripts/ensure-better-sqlite3.mjs && vitest tests --run",
    "docs:dev": "cd docs && pnpm run dev",
    "docs:build": "cd docs && pnpm run build",
    "docs:preview": "cd docs && pnpm run preview",
    "static-api:serve": "node apps/static-api/index.js",
    "static-api:docker:build": "docker build -t argentinadatos-api .",
    "static-api:docker:run": "docker run --rm -p 3000:3000 -v \"$(pwd)/datos:/app/datos:ro\" argentinadatos-api",
    "static-api:docker:up": "docker compose --env-file /dev/null up --build -d",
    "static-api:docker:down": "docker compose --env-file /dev/null down",
    "worker:migrate": "pnpm --filter @argentinadatos/worker migrate",
    "worker:migrate:fresh": "pnpm --filter @argentinadatos/worker migrate:fresh",
    "worker:sync": "pnpm --filter @argentinadatos/worker sync",
    "worker:start": "pnpm --filter @argentinadatos/worker start",
    "format": "prettier --write src tests apps",
    "senado:test": "cd packages/senado && pnpm test",
    "senado:test:run": "cd packages/senado && pnpm run test:run",
    "diputados:test": "cd packages/diputados && pnpm test",
    "diputados:test:run": "cd packages/diputados && pnpm run test:run",
    "cafci-worker:crawl": "pnpm --filter @argentinadatos/cafci-worker crawl",
    "cafci-worker:test": "node scripts/ensure-better-sqlite3.mjs && vitest run tests/cafci-worker",
    "cafci-worker:start": "pnpm --filter @argentinadatos/cafci-worker start",
    "cafci-worker:r2:backup": "pnpm --filter @argentinadatos/cafci-worker r2:backup",
    "cafci-worker:r2:download": "pnpm --filter @argentinadatos/cafci-worker r2:download",
    "cafci-worker:db:rebuild-from-static": "pnpm --filter @argentinadatos/cafci-worker db:rebuild-from-static",
    "cafci-worker:db:backfill-cnv": "pnpm --filter @argentinadatos/cafci-worker db:backfill-cnv",
    "cafci-worker:fresh": "pnpm --filter @argentinadatos/cafci-worker db:fresh-cnv",
    "migrate": "node scripts/migrate.js",
    "pb:migrate": "node packages/pocketbase/src/migrate.js",
    "pb:migrate:fresh": "node packages/pocketbase/src/migrate.js --fresh",
    "pb:export-turso": "node scripts/turso-export.js",
    "pb:import-turso": "node scripts/pb-import-turso.js",
    "seed:fci-otros": "node scripts/seed-fci-otros.js",
    "procesar-dolares": "node scripts/procesar-dolares.js todos"
  },
  "devDependencies": {
    "@es-js/vite-plugin-esjs": "^0.1.0",
    "axios": "^1.19.0",
    "cheerio": "1.0.0-rc.12",
    "collect.js": "^4.36.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "fs": "0.0.1-security",
    "glob": "^13.0.6",
    "parse-decimal-number": "^1.0.0",
    "path": "^0.12.7",
    "pino": "^10.3.1",
    "pino-axiom": "^1.0.432",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-esjs": "^0.1.0",
    "sitemap": "^9.0.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "endOfLine": "auto"
  },
  "dependencies": {
    "@argentinadatos/pocketbase": "workspace:*",
    "@libsql/client": "^0.15.15",
    "better-sqlite3": "^12.11.1",
    "defuddle": "^0.18.1",
    "pdf-parse": "1.1.1",
    "xlsx": "^0.18.5"
  }
}
